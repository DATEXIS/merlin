FROM unsloth/unsloth:latest

USER root

# --- FIX: SYNC BOTH LIBRARIES ---
# We update BOTH unsloth and unsloth_zoo from source to ensure they match.
# We use --no-deps to protect the B200-optimized PyTorch/Flash-Attn.
RUN pip install --no-cache-dir --upgrade --no-deps \
    "unsloth[colab-new] @ git+https://github.com/unslothai/unsloth.git" \
    "unsloth_zoo @ git+https://github.com/unslothai/unsloth-zoo.git"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install basics
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget htop nano \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deployment/requirements_fine_tuning.txt .

# SAFETY CHECK
RUN sed -i '/torch/d' requirements_fine_tuning.txt && \
    sed -i '/flash-attn/d' requirements_fine_tuning.txt && \
    sed -i '/xformers/d' requirements_fine_tuning.txt && \
    sed -i '/triton/d' requirements_fine_tuning.txt && \
    sed -i '/transformers/d' requirements_fine_tuning.txt && \
    sed -i '/peft/d' requirements_fine_tuning.txt && \
    sed -i '/accelerate/d' requirements_fine_tuning.txt && \
    sed -i '/bitsandbytes/d' requirements_fine_tuning.txt && \
    sed -i '/trl/d' requirements_fine_tuning.txt

# Install remaining deps (forcing numpy<2.0)
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r requirements_fine_tuning.txt

COPY src ./src
COPY src/fine_tuning/entrypoint.py .
ENV PYTHONPATH="/app"